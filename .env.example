# Docker Compose reads this file. Copy it to .env on the VPS.
QUANTA_DOMAIN=board.example.com
QUANTA_ADMIN_EMAIL=you@example.com
# Replace before starting. Minimum 12 characters. Used only to create the owner.
QUANTA_ADMIN_PASSWORD=replace-with-a-long-random-password
# Optional. Encrypts members' saved API keys; without it a random key is kept in the data volume.
# QUANTA_SECRET=
