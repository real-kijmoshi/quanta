{
  "name": "quanta-whiteboard",
  "version": "0.13.1",
  "private": true,
  "license": "MIT",
  "author": "igor rypniewski",
  "homepage": "https://real-kijmoshi.github.io/quanta/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/real-kijmoshi/quanta.git"
  },
  "bugs": {
    "url": "https://github.com/real-kijmoshi/quanta/issues"
  },
  "keywords": ["whiteboard", "notebook", "handwriting", "math", "collaboration", "mcp", "self-hosted"],
  "bin": {
    "quanta": "bin/quanta.mjs"
  },
  "files": ["bin", "client", "server", "shared", "scripts", "deploy", "docs", "README.md", "LICENSE", "npm-shrinkwrap.json"],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "description": "Collaborative whiteboard and notebook: handwriting, typeset math, plots, runnable code, live sync, MCP",
  "scripts": {
    "build:site": "node scripts/build-site.mjs",
    "demo:bake": "node scripts/bake-demo.mjs",
    "start": "node server/index.mjs",
    "check": "node scripts/check.mjs",
    "test:performance": "node tests/performance-test.mjs",
    "test:selection": "node tests/selection-test.mjs",
    "test:site": "node tests/site-ink-test.mjs",
    "test:demo": "node tests/demo-test.mjs",
    "test:notes": "node tests/notes-test.mjs",
    "test:writing": "node tests/writing-test.mjs",
    "test:trailer": "node tests/trailer-test.mjs",
    "test:ai": "node tests/ai-test.mjs",
    "test:cli": "node tests/cli-test.mjs",
    "test:storage": "node tests/storage-test.mjs",
    "test:recovery": "node tests/client-recovery-test.mjs",
    "test:collaboration": "node tests/collaboration-test.mjs",
    "test:websocket": "node tests/websocket-test.mjs",
    "test:folders": "node tests/folders-test.mjs",
    "test:hosted": "node tests/hosted-test.mjs",
    "test:connections": "node tests/connections-test.mjs",
    "test:templates": "node tests/template-dialog-test.mjs",
    "backup": "node scripts/backup.mjs",
    "backup:verify": "node scripts/backup.mjs --verify",
    "test": "npm run check && npm run test:performance && npm run test:selection && npm run test:site && npm run test:notes && npm run test:writing && npm run test:trailer && npm run test:storage && npm run test:recovery && npm run test:collaboration && npm run test:websocket && npm run test:folders && npm run test:hosted && npm run test:connections && npm run test:templates && npm run test:ai && npm run test:cli && npm run test:maintenance",
    "share": "node server/index.mjs --share",
    "tunnel": "node scripts/tunnel.mjs",
    "test:maintenance": "node tests/maintenance-test.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@huggingface/transformers": "^4.3.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "katex": "^0.18.10",
    "pdfjs-dist": "^4.10.38",
    "tesseract.js": "^7.0.0",
    "ws": "^8.22.0",
    "zod": "^3.25.76"
  }
}
